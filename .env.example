# ===========================================================================
# VoteBattle - Environment variables (EXAMPLE)
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ===========================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# The docker-compose file uses these to create the local database.
# ---------------------------------------------------------------------------
POSTGRES_USER=votebattle
POSTGRES_PASSWORD=change_me_in_dev
POSTGRES_DB=votebattle
POSTGRES_PORT=5432

# Connection string used by the backend (matches the values above).
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=votebattle;Username=votebattle;Password=change_me_in_dev

# ---------------------------------------------------------------------------
# Authentication
# JWT_SECRET is used to sign the auth token embedded in the HttpOnly cookie.
# Must be a long random string in production (min 32 chars).
# ---------------------------------------------------------------------------
JWT_SECRET=please_generate_a_long_random_secret_at_least_32_chars
JWT_ISSUER=VoteBattle
JWT_AUDIENCE=VoteBattle
JWT_EXPIRY_MINUTES=1440

# ---------------------------------------------------------------------------
# Stripe (use TEST keys in development, LIVE keys only in production)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA)
# In development CAPTCHA can be disabled via TURNSTILE_ENABLED=false.
# In production it MUST be enabled.
# ---------------------------------------------------------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ---------------------------------------------------------------------------
# Email
# In development we use Mailhog (SMTP catcher) started by docker-compose.
# In production use a real provider (Resend, Brevo, SendGrid...).
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@votebattle.local
EMAIL_FROM_NAME=VoteBattle
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# ---------------------------------------------------------------------------
# Rate limiting (requests per minute, per user id or IP). Optional — defaults apply.
# ---------------------------------------------------------------------------
RATELIMIT_AUTH_PER_MINUTE=10
RATELIMIT_VOTE_PER_MINUTE=120
RATELIMIT_COMMENT_PER_MINUTE=15
RATELIMIT_CHECKOUT_PER_MINUTE=10
RATELIMIT_WEBHOOK_PER_MINUTE=300

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Uploads (locally-stored battle images)
# UPLOADS_PATH: folder where uploaded images are written (a Docker volume in
#   docker-compose keeps them across restarts).
# BACKEND_PUBLIC_URL: public API base used to build image URLs the browser loads
#   (defaults to BACKEND_URL). Set to your API's public URL in production.
# ---------------------------------------------------------------------------
UPLOADS_PATH=uploads
BACKEND_PUBLIC_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Frontend (Next.js) - variables exposed to the browser must start with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
